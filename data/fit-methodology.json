{
  "name": "AgentenFit",
  "version": "1.0",
  "updated": "2026-10-02",
  "url": "https://agentenindex.de/fit/",
  "engine": "deterministic_client_side",
  "source_datasets": [
    "https://agentenindex.de/data/agents.json",
    "https://agentenindex.de/data/agent-deep-evidence.json",
    "https://agentenindex.de/data/agent-deep-taxonomy.json"
  ],
  "purpose": "Anforderungsbezogener Fit-Check für konkrete KI-Agenten auf Basis kuratierter feldgenauer Primärquellen-Evidenz. Keine allgemeine Qualitätsbewertung.",
  "state_model": {
    "confirmed": "Für den ausgewählten Feldpfad liegt kuratierte Field-Level-Evidenz mit true oder einem dokumentierten Wert vor.",
    "documented_false": "false wird ausschließlich gezeigt, wenn der kuratierte Claim ausdrücklich false ist und Primärquellen-Evidenz trägt.",
    "unknown": "Kein kuratierter Field-Level-Claim für den ausgewählten Feldpfad. Unknown wird niemals als false behandelt."
  },
  "ranking": {
    "primary": "Weniger dokumentierte Widersprüche zuerst.",
    "secondary": "Mehr bestätigte ausgewählte Anforderungen.",
    "tertiary": "Weniger unbekannte ausgewählte Anforderungen.",
    "final_tie_breaker": "Alphabetisch nach Agentenname.",
    "note": "Die Reihenfolge ist nur ein Fit zur aktuellen Auswahl und kein Qualitätsranking."
  },
  "filters": {
    "category": "data/agents.json: category",
    "audience": "data/agents.json: filters.audience",
    "lifecycle": "Produkte mit lifecycle_status=discontinued werden aus dem aktiven Fit ausgeschlossen."
  },
