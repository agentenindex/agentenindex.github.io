{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentenIndex Agent Record v3",
  "type": "object",
  "required": [
    "name",
    "slug",
    "provider",
    "category",
    "type",
    "summary",
    "sources"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "provider": {
      "type": "string"
    },
    "category": {
      "enum": [
        "recherche",
        "coding",
        "automatisierung",
        "unternehmen",
        "service-sales",
        "recht"
      ]
    },
    "type": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1
    }
  }
}